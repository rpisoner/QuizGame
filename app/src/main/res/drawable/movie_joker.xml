<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Fondo -->
    <path
        android:fillColor="#1C1C1E"
        android:pathData="M0,0 L200,0 L200,200 L0,200 Z"/>

    <!-- Cara de Heath Ledger como Joker - Silueta estilizada -->
    <path
        android:fillColor="#E8D4B8"
        android:pathData="M100,40 L85,60 L80,90 L75,120 L80,150 L90,165 L110,165 L120,150 L125,120 L120,90 L115,60 Z"/>

    <!-- Cabello -->
    <path
        android:fillColor="#4A6F3C"
        android:pathData="M70,35 Q100,20 130,35 L125,55 Q100,45 75,55 Z"/>

    <!-- Ojos oscuros -->
    <path
        android:fillColor="#000000"
        android:pathData="M85,70 L95,70 L95,85 L85,85 Z"/>

    <path
        android:fillColor="#000000"
        android:pathData="M105,70 L115,70 L115,85 L105,85 Z"/>

    <!-- Sonrisa característica del Joker -->
    <path
        android:strokeColor="#DC143C"
        android:strokeWidth="4"
        android:pathData="M75,110 Q100,130 125,110"/>

    <!-- Cicatrices -->
    <path
        android:strokeColor="#8B0000"
        android:strokeWidth="2"
        android:pathData="M70,105 L75,110"/>

    <path
        android:strokeColor="#8B0000"
        android:strokeWidth="2"
        android:pathData="M125,110 L130,105"/>

    <!-- Maquillaje blanco (efecto) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.3"
        android:pathData="M85,60 L90,90 L95,90 L95,60 Z"/>

    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.3"
        android:pathData="M105,60 L110,90 L115,90 L110,60 Z"/>
</vector>

