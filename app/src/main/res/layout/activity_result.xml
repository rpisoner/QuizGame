<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1C1C1E">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_clapperboard"
        android:layout_marginBottom="20dp"
        android:contentDescription="Clapperboard"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎬 ¡ACCIÓN!"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginBottom="10dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quiz Completado"
        android:textSize="18sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="30dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:elevation="8dp"
        android:radius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="#2C2C2E"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ PUNTUACIÓN FINAL ⭐"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Puntuación Final: 0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% de respuestas correctas"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#DC143C"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensaje de resultado"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:textAlignment="center"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎬 JUGAR DE NUEVO"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#DC143C"
        android:textColor="#FFD700"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="4dp"/>

    <Button
        android:id="@+id/btnMainMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#3A3A3C"
        android:elevation="6dp"
        android:padding="16dp"
        android:text="⌂ MENÚ PRINCIPAL"
        android:textColor="#FFD700"
        android:textSize="12sp" />

</LinearLayout>